{
  // TypeScript configuration for setup-liquibase GitHub Action
  "compilerOptions": {
    // Target ES2024 for Node.js 24 compatibility in GitHub Actions
    "target": "ES2024",
    "lib": ["ES2024"],
    
    // Use CommonJS modules for Node.js compatibility
    "module": "commonjs",
    
    // Output compiled JavaScript to lib directory
    "outDir": "lib",
    "rootDir": "src",
    
    // Enable strict type checking for better code quality
    "strict": true,
    "noImplicitAny": true,
    
    // Module resolution and compatibility settings
    // Explicitly set node10 (the implicit default for "module": "commonjs").
    // TypeScript 6.0 deprecated the implicit default and now errors (TS5107)
    // if moduleResolution is not specified. ignoreDeprecations silences that
    // error until this project migrates to ESM (see #145).
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    
    // Generate declaration files and source maps for debugging
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    
    // Enable isolated modules for ts-jest compatibility
    "isolatedModules": true,

    // TypeScript 6.0 no longer auto-includes Node.js globals (path, fs, process,
    // Buffer, etc.) — must be explicit
    "types": ["node"]
  },
  
  // Include all TypeScript files in the src directory
  "include": ["src/**/*"],
  
  // Exclude unnecessary directories and files from compilation
  "exclude": ["node_modules", "**/*.test.ts", "lib", "dist"]
}